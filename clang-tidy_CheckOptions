#readability 
#-identifier-naming 
#— 変数や関数の命名規則を設定
CheckOptions:
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.FunctionCase: camelCase
  readability-identifier-naming.ClassCase: PascalCase

#cppcoreguidelines — C++ コア ガイドラインの有効化
CheckOptions:
  cppcoreguidelines-pro-bounds-pointer-arithmetic.Enabled: true
  cppcoreguidelines-init-variables.VariableDeclarations: 'true'

#modernize — C++ 標準の最新化
CheckOptions:
  modernize-use-auto.MinTypeNameLength: 5
  modernize-use-nullptr.NullMacros: 'NULL'

#performance — パフォーマンス関連
CheckOptions: 
  performance-inefficient-string-concatenation. Abs oluteValueInRangeCheck: false

# .clangd  サンプルコード
Diagnostics:
  ClangTidy:
    CheckOptions:
      readability-identifier-naming.TypeNameLength: '0'
      readability-identifier-naming.VariableNameLength: '0'
      readability-identifier-naming.FunctionNameLength: '0'
      readability-identifier-naming.ClassNameLength: '0'
    Add:
      - modernize-use-auto
      - modernize-use-nullptr
      - readability-*
    Remove:
      - modernize-use-trailing-return-type
      - modernize-use-nodiscard
      - readability-magic-numbers
      - readability-else-after-return


#.clang-tidy のサンプル
---
Checks: >
  modernize-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -readability-magic-numbers,
  -readability-else-after-return

CheckOptions:
  readability-identifier-naming.TypeNameLength: '0'
  readability-identifier-naming.VariableNameLength: '0'
  readability-identifier-naming.FunctionNameLength: '0'
  readability-identifier-naming.ClassNameLength: '0'

